-# A sparkline: a chart.Sparkline. It writes no style attribute, so it
-# renders under a Content-Security-Policy of style-src 'self'. The
-# labels sit in plain order around the SVG, and CSS places them.
- if data.has_chart
  .chart-sparkline
    .chart-sparkline-axis
      %span
        = data.top
      %span
        = data.bottom
    %svg.chart-sparkline-svg{ viewBox: data.view_box, preserveAspectRatio: "none", "aria-hidden": "true" }
      - if data.has_zero
        %line.chart-plot-zero{ x1: "0%", x2: "100%", y1: data.zero_y, y2: data.zero_y }
      - for shape in data.shapes
        %polyline.chart-lines-line{ class: shape.class, points: shape.points }
    .chart-sparkline-dates
      %span
        = data.start
      %span
        = data.end
